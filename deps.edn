{:paths ["src" "resources"]

 ;; What a consumer receives: Clojure, and nothing else. The components answer Hiccup data,
 ;; which needs no library to build; they call web-base (the root of the set, as
 ;; db-base.web does) for links and the CSRF field, and web-base is undeclared here because
 ;; every host of this kit already has it. The colour engine (`color`, `brand`, `audit`,
 ;; `emit`, `build`) is in the jar but never loaded at run time: a host generates its
 ;; colours once and commits the file, and structure_test holds the components to that.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases
 {:test {:extra-paths ["test" "test/resources"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       dev.arkaitz/web-base                 {:mvn/version "0.25.0"}
                       ring/ring-mock                       {:mvn/version "0.6.2"}}
         :main-opts   ["-m" "cognitect.test-runner" "-d" "test"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; Every component on one page behind the template's CSP: `clojure -M:gallery [port]`.
  :gallery {:extra-paths ["test" "test/resources"]
            :extra-deps  {dev.arkaitz/web-base {:mvn/version "0.25.0"}}
            :main-opts   ["-m" "dev.arkaitz.uikit-base.gallery"]}

  ;; The release: `clojure -T:build jar | install | deploy | verify-release`. The guards in
  ;; build/release.clj refuse a dirty, unpushed or already-tagged tree.
  :build {:extra-paths ["build"]
          :deps        {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                        slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default  build}

  ;; The release guards' own suite, against real git.
  :build-test {:extra-paths ["build" "test-build"]
               :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             io.github.clojure/tools.build        {:mvn/version "0.10.14"}}
               :main-opts   ["-m" "cognitect.test-runner" "-d" "test-build"]}}}
